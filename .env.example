# Supabase — URL du projet et clé publique (publishable / anon), jamais la clé secrète.
# En local (npx supabase start) : valeurs affichées par `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clé SECRÈTE (secret / service_role) — SERVEUR UNIQUEMENT, jamais préfixée NEXT_PUBLIC_.
# Nécessaire seulement pour créer des comptes depuis Paramètres → Utilisateurs (invitations).
SUPABASE_SECRET_KEY=
